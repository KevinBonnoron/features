{
  "id": "ffmpeg",
  "version": "0.0.5",
  "name": "ffmpeg",
  "documentationURL": "https://github.com/KevinBonnoron/features/tree/main/src/ffmpeg",
  "description": "Install ffmpeg from source.",
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "FFmpeg version to install (e.g., '7.1', '6.1.1', 'latest', 'system', 'apt'). Default is 'latest'."
    },
    "openssl": {
      "type": "boolean",
      "default": true,
      "description": "Enable OpenSSL support for HTTPS protocols"
    },
    "libvpx": {
      "type": "boolean",
      "default": false,
      "description": "Enable libvpx support (VP8/VP9 codec)"
    }
  }
}