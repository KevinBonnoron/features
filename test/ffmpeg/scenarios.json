{
  "specific_version": {
    "image": "ubuntu:22.04",
    "features": {
      "ffmpeg": {
        "version": "7.0"
      }
    }
  },
  "with_libvpx": {
    "image": "ubuntu:22.04",
    "features": {
      "ffmpeg": {
        "version": "latest",
        "libvpx": true
      }
    },
    "remoteEnv": {
      "LIBVPX": "true"
    }
  },
  "with_openssl": {
    "image": "ubuntu:22.04",
    "features": {
      "ffmpeg": {
        "version": "latest",
        "openssl": true
      }
    }
  },
  "debian_latest": {
    "image": "debian:12",
    "features": {
      "ffmpeg": {
        "version": "latest",
        "libvpx": false
      }
    }
  }
}
